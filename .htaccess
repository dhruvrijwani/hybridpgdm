# Hybrid PGDM landing page: Apache rules for the project folder.
# Every request goes into public/, which is the only folder the web can see.
# The code (app/), settings (config/), copy (content/) and tools stay private.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # If the site sits in a sub-folder and links break, set the folder here, e.g.
  # RewriteBase /hybrid-pgdm/

  RewriteRule ^(app|config|content|tools|dist)(/|$) - [F,L]
  RewriteRule ^(README\.md|\.git.*)$ - [F,L]

  RewriteCond %{REQUEST_URI} !/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
